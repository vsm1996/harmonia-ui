{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "lib",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "lib/capacity/**/*.ts",
    "lib/capacity/**/*.tsx",
    "lib/components/**/*.ts",
    "lib/components/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "components",
    "lib/capacity/__tests__"
  ]
}
